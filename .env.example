# Dead Channel — provider API keys (copy to .env and fill in; .env is gitignored)

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Perplexity (perplexity.ai — used for OSINT-flavored rendering)
PPLX_API_KEY=

# Model matrix defaults are configured per-run in the viewer's config screen
# (global default + per-state + per-role overrides). To run every agent on one
# model, set the global default there — e.g. openrouter:stealth/ox-alpha —
# and leave the per-state/per-role slots empty (they fall back up the chain).
